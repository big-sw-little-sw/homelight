#!/usr/bin/expect -f
# Drives the TUI's Configuration screen on a pty: a new file, discovery from the bundled candidate list, then
# discard.
#
#   expect ci/native/setup.exp <logfile> <source-root> <target-root> <command...>
#
# <source-root> must contain a .m2 directory; the command must point at a missing config file
# (`homelight -c <new.json> init`). Configuration opens on Target root: types it, then the source
# root above it, goes back to the list, opens Browse and expects the bundled Maven candidate, which
# proves candidates.json is in the binary. Then discards the draft and quits. Prints one line of
# key=value results; exit status 0 when every check passed.
# Treat pty output as bytes so the log keeps the TUI's UTF-8 intact under any locale.
encoding system iso8859-1
set logfile [lindex $argv 0]
set source [lindex $argv 1]
set target [lindex $argv 2]
set cmd [join [lrange $argv 3 end] " "]
log_user 0
log_file -a -noappend $logfile
set stty_init "rows 30 cols 120"
set env(PS1) "PROMPT> "
set result ""
set failed 0

proc step {name pattern} {
  global result failed
  expect {
    -re $pattern { append result "$name=ok " }
    timeout { append result "$name=timeout(FAIL) "; set failed 1 }
    eof { append result "$name=eof(FAIL) "; set failed 1 }
  }
}

spawn -noecho /bin/sh
set timeout 20
expect "PROMPT> "
send "$cmd; echo EXITCODE=\$?\r"
step setup {\[Configuration\]}
# Target root is focused; then up to Source root, clear it (Ctrl-U) and type the directory holding .m2.
send $target
after 300
send "\033\[A"
after 300
send "\025$source"
after 300
# Back to the list, then Browse.
send "\033"
after 300
send "b"
step discovery {Maven}
send_log "\n@@QUIT@@\n"
# Back to the list, discard the draft (q, then y to confirm), quit the workspace.
foreach key {"\033" q y q} {
  send $key
  after 300
}
expect {
  -re {EXITCODE=([0-9]+)} {
    append result "exit=$expect_out(1,string) "
    if {$expect_out(1,string) != 0} { set failed 1 }
  }
  timeout { append result "exit=hang(FAIL) "; set failed 1; send "\003" }
}
log_file
puts [string trim $result]
exit $failed
